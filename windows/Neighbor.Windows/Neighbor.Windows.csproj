<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><LangVersion>latest</LangVersion><Nullable>disable</Nullable>
    <OutputType>WinExe</OutputType><PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>Neighbor</AssemblyName><RootNamespace>Neighbor.Windows</RootNamespace>
    <Version>0.1.0</Version><AssemblyVersion>0.1.0.0</AssemblyVersion><FileVersion>0.1.0.0</FileVersion>
    <ApplicationIcon>../assets/neighbor.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Neighbor.Core/Neighbor.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
    <Reference Include="UIAutomationClient" /><Reference Include="UIAutomationTypes" /><Reference Include="WindowsBase" />
    <Reference Include="System.Web.Extensions" /><Reference Include="System.Net.Http" />
    <EmbeddedResource Include="../assets/neko-base.png" LogicalName="Neighbor.cat.png" />
    <EmbeddedResource Include="../assets/neighbor.ico" LogicalName="Neighbor.cat.ico" />
  </ItemGroup>
</Project>
